# ---------- Shared ----------
NODE_ENV=development

# ---------- Server (NestJS) ----------
SERVER_PORT=4000
# Comma-separated list of allowed web origins for CORS / Socket.IO
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://aimafia:aimafia@localhost:5432/aimafia?schema=public

# Redis (room state + Socket.IO adapter). Leave blank to run single-instance in-memory.
REDIS_URL=redis://localhost:6379

# Ollama (server-side only; never exposed to browser)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
AI_INFERENCE_TIMEOUT_MS=8000

# ---------- Web (Next.js) ----------
# Public URL the browser uses to reach the server / Socket.IO
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
